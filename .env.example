# Configuración de base de datos PostgreSQL local
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me

# Backend Config
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security
# Generar secreto con: openssl rand -base64 48
JWT_SECRET=generar_secreto_de_al_menos_32_bytes_aqui
ADMIN_USERNAME=admin
# Generar hash con: docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'PASSWORD' | tr -d ':\n'
# ADVERTENCIA: En el archivo .env (y para que Docker Compose no interprete los $ del hash de bcrypt),
# envuelve este valor entre comillas simples: ADMIN_PASSWORD_HASH='$2y$10$...'
ADMIN_PASSWORD_HASH=generar_hash_aqui
